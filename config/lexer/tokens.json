{
  "schema_version": "1.0",
  "tokens": [
    {"name": "WHITESPACE", "matcher": "whitespace", "emit": false},
    {"name": "COMMENT", "matcher": "line_comment", "emit": false},
    {"name": "IDENTIFIER", "matcher": "identifier"},
    {"name": "INTEGER", "matcher": "decimal_integer"},
    {"name": "HEX_INTEGER", "matcher": "hex_integer"},
    {"name": "BINARY_INTEGER", "matcher": "binary_integer"},
    {"name": "STRING", "matcher": "quoted_string"},
    {"name": "DOT", "matcher": "literal", "value": ".", "priority": 10},
    {"name": "COMMA", "matcher": "literal", "value": ",", "priority": 10},
    {"name": "COLON", "matcher": "literal", "value": ":", "priority": 10},
    {"name": "LEFT_BRACKET", "matcher": "literal", "value": "[", "priority": 10},
    {"name": "RIGHT_BRACKET", "matcher": "literal", "value": "]", "priority": 10},
    {"name": "LEFT_PAREN", "matcher": "literal", "value": "(", "priority": 10},
    {"name": "RIGHT_PAREN", "matcher": "literal", "value": ")", "priority": 10},
    {"name": "EQUALS", "matcher": "literal", "value": "=", "priority": 10},
    {"name": "PLUS", "matcher": "literal", "value": "+", "priority": 10},
    {"name": "MINUS", "matcher": "literal", "value": "-", "priority": 10},
    {"name": "STAR", "matcher": "literal", "value": "*", "priority": 10},
    {"name": "SLASH", "matcher": "literal", "value": "/", "priority": 10}
  ]
}
