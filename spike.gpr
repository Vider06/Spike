with "gnatcoll_core";

project Spike is
   for Languages use ("Ada");
   for Source_Dirs use
     ("src/api",
      "src/frontend/lexer",
      "src/leng/verbs",
      "src/backend/quick/vm/state",
      "src/backend/quick/vm/memory",
      "src/backend/quick/vm/instructions",
      "src/backend/quick/vm/stack",
      "tests/api",
      "tests/leng",
      "tests/frontend/lexer",
      "tests/backend/vm",
      "tests/proofs/frontend",
      "tests/proofs/vm");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build/bin";
   for Main use
     ("test_spike_api.adb",
      "test_verb_table.adb",
      "test_machine_state.adb",
      "test_virtual_memory.adb",
      "test_vm_instructions.adb",
      "test_vm_stack.adb",
      "test_lexer.adb",
      "fuzz_lexer.adb",
      "prove_virtual_memory.adb",
      "prove_vm_stack.adb",
      "prove_lexer_properties.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",
         "-gnata",
         "-gnatVa",
         "-gnato",
         "-gnatwa",
         "-gnatwe",
         "-gnatf");
   end Compiler;
end Spike;
