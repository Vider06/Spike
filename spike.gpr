project Spike is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "tests");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build/bin";
   for Main use ("test_machine_state.adb", "test_virtual_memory.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatf");
   end Compiler;
end Spike;
